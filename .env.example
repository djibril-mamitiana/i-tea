# Copiez ce fichier en `.env.local` (développement) ou définissez ces variables
# chez votre hébergeur (production, ex. Vercel > Settings > Environment Variables).

# URL publique du site (SEO, partages, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.exemple.com

# --- Espace admin (/admin) ---------------------------------------------------
# Mot de passe de l'espace restaurant. 10 caractères minimum, long et unique :
# une phrase de passe est idéale. Sans cette variable, /admin reste désactivé.
ADMIN_PASSWORD=
# (facultatif) clé de signature des sessions, indépendante du mot de passe
# ADMIN_SESSION_SECRET=

# --- Base de données PostgreSQL (commandes + admin) ---------------------------
# Production / Vercel : une base Postgres, par exemple Neon (https://neon.tech).
# Copiez la « connection string » de votre projet Neon (de préférence la version « pooled »).
# C'est un SECRET : ne la commitez jamais, saisissez-la dans Vercel > Environment Variables.
# DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Sans cette variable (développement, VPS), un Postgres embarqué est utilisé : ./data/pglite
# (PGLITE_DATA_DIR pour changer le dossier). Sur Vercel, DATABASE_URL est obligatoire.

# --- Notification du restaurant à chaque nouvelle commande -------------------

# 1) Webhook générique (Slack, Discord, Mattermost, n8n, Make, Zapier…)
#    Reçoit un POST JSON { text, content, order }
# ORDER_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# 2) Telegram : créez un bot avec @BotFather, ajoutez-le à une conversation, notez l'id de chat.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_CHAT_ID=123456789
